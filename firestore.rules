rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Global default-deny safety net
    match /{document=**} {
      allow read, write: if false;
    }

    // --- Shared Security Primitives ---
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isBoundedStringList(listVal, maxItems, maxItemLen) {
      return listVal is list &&
             listVal.size() <= maxItems &&
             (listVal.size() == 0 || (listVal[0] is string && listVal[0].size() <= maxItemLen));
    }

    // --- Entity Validation Blueprints ---
    function isValidUserProfile(data) {
      return data.userId is string && data.userId == request.auth.uid &&
             data.displayName is string && data.displayName.size() >= 1 && data.displayName.size() <= 80 &&
             (!('email' in data) || (data.email is string && data.email.size() <= 120)) &&
             (!('bio' in data) || (data.bio is string && data.bio.size() <= 300)) &&
             data.preferredModelId is string && data.preferredModelId.size() >= 1 && data.preferredModelId.size() <= 64 &&
             data.bengaliVoiceEnabled is bool &&
             (!('voiceSpeed' in data) || (data.voiceSpeed is number && data.voiceSpeed >= 0.5 && data.voiceSpeed <= 2.0)) &&
             (!('voicePitch' in data) || (data.voicePitch is number && data.voicePitch >= 0.5 && data.voicePitch <= 2.0)) &&
             data.darkModeOverride in ['system', 'dark', 'light'];
    }

    function isValidConversation(data) {
      return data.userId is string && data.userId == request.auth.uid &&
             data.title is string && data.title.size() >= 1 && data.title.size() <= 120 &&
             data.modelId is string && data.modelId.size() >= 1 && data.modelId.size() <= 64 &&
             data.lastMessagePreview is string && data.lastMessagePreview.size() <= 300 &&
             data.messageCount is int && data.messageCount >= 0 && data.messageCount <= 100000 &&
             data.pinned is bool &&
             data.writingMode in ['chat', 'writing', 'code', 'research', 'bengali'];
    }

    function isValidChatMessage(data, conversationId) {
      return data.userId is string && data.userId == request.auth.uid &&
             data.conversationId is string && data.conversationId == conversationId &&
             data.role in ['user', 'assistant'] &&
             data.content is string && data.content.size() <= 25000 &&
             data.modelId is string && data.modelId.size() <= 64 &&
             data.modelName is string && data.modelName.size() <= 80 &&
             isBoundedStringList(data.attachmentNames, 10, 200) &&
             isBoundedStringList(data.citationTitles, 10, 200) &&
             isBoundedStringList(data.citationUrls, 10, 500);
    }

    function isValidSavedPrompt(data) {
      return data.userId is string && data.userId == request.auth.uid &&
             data.title is string && data.title.size() >= 1 && data.title.size() <= 100 &&
             data.body is string && data.body.size() >= 1 && data.body.size() <= 4000 &&
             data.category is string && data.category.size() >= 1 && data.category.size() <= 40;
    }

    // --- Collection Rules ---
    match /users/{userId} {
      allow get: if isOwner(userId) && isValidId(userId);
      allow list: if false;

      allow create: if isOwner(userId) &&
                       isValidId(userId) &&
                       incoming().keys().hasAll(['userId', 'displayName', 'preferredModelId', 'bengaliVoiceEnabled', 'darkModeOverride', 'createdAt', 'updatedAt']) &&
                       incoming().keys().hasOnly(['userId', 'displayName', 'email', 'bio', 'preferredModelId', 'bengaliVoiceEnabled', 'voiceSpeed', 'voicePitch', 'darkModeOverride', 'createdAt', 'updatedAt']) &&
                       incoming().createdAt is timestamp && incoming().createdAt <= request.time &&
                       incoming().updatedAt is timestamp && incoming().updatedAt <= request.time &&
                       isValidUserProfile(incoming());

      allow update: if isOwner(userId) &&
                       isValidId(userId) &&
                       isValidUserProfile(incoming()) &&
                       incoming().userId == existing().userId &&
                       incoming().createdAt == existing().createdAt &&
                       incoming().updatedAt is timestamp && incoming().updatedAt <= request.time &&
                       incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'email', 'bio', 'preferredModelId', 'bengaliVoiceEnabled', 'voiceSpeed', 'voicePitch', 'darkModeOverride', 'updatedAt']);

      allow delete: if isOwner(userId) && isValidId(userId);

      // User-scoped conversations
      match /conversations/{conversationId} {
        allow get: if isOwner(userId) && isValidId(conversationId);
        allow list: if isOwner(userId);

        allow create: if isOwner(userId) &&
                         isValidId(conversationId) &&
                         incoming().keys().hasAll(['userId', 'title', 'modelId', 'lastMessagePreview', 'messageCount', 'pinned', 'writingMode', 'createdAt', 'updatedAt']) &&
                         incoming().keys().hasOnly(['userId', 'title', 'modelId', 'lastMessagePreview', 'messageCount', 'pinned', 'writingMode', 'createdAt', 'updatedAt']) &&
                         incoming().createdAt is timestamp && incoming().createdAt <= request.time &&
                         incoming().updatedAt is timestamp && incoming().updatedAt <= request.time &&
                         isValidConversation(incoming());

        allow update: if isOwner(userId) &&
                         isValidId(conversationId) &&
                         isValidConversation(incoming()) &&
                         incoming().userId == existing().userId &&
                         incoming().createdAt == existing().createdAt &&
                         incoming().updatedAt is timestamp && incoming().updatedAt <= request.time &&
                         (
                           incoming().diff(existing()).affectedKeys().hasOnly(['title', 'pinned', 'updatedAt']) ||
                           incoming().diff(existing()).affectedKeys().hasOnly(['modelId', 'writingMode', 'updatedAt']) ||
                           incoming().diff(existing()).affectedKeys().hasOnly(['title', 'modelId', 'lastMessagePreview', 'messageCount', 'writingMode', 'updatedAt'])
                         );

        allow delete: if isOwner(userId) && isValidId(conversationId);

        // Messages subcollection (immutable once created; deletable on thread cleanup)
        match /messages/{messageId} {
          allow get: if isOwner(userId) && isValidId(conversationId) && isValidId(messageId);
          allow list: if isOwner(userId) && isValidId(conversationId);

          allow create: if isOwner(userId) &&
                           isValidId(conversationId) &&
                           isValidId(messageId) &&
                           incoming().keys().hasAll(['userId', 'conversationId', 'role', 'content', 'modelId', 'modelName', 'attachmentNames', 'citationTitles', 'citationUrls', 'createdAt']) &&
                           incoming().keys().hasOnly(['userId', 'conversationId', 'role', 'content', 'modelId', 'modelName', 'attachmentNames', 'citationTitles', 'citationUrls', 'createdAt']) &&
                           incoming().createdAt is timestamp && incoming().createdAt <= request.time &&
                           isValidChatMessage(incoming(), conversationId) &&
                           existsAfter(/databases/$(database)/documents/users/$(userId)/conversations/$(conversationId));

          allow update: if false;
          allow delete: if isOwner(userId) && isValidId(conversationId) && isValidId(messageId);
        }
      }

      // User-scoped saved prompts
      match /prompts/{promptId} {
        allow get: if isOwner(userId) && isValidId(promptId);
        allow list: if isOwner(userId);

        allow create: if isOwner(userId) &&
                         isValidId(promptId) &&
                         incoming().keys().hasAll(['userId', 'title', 'body', 'category', 'createdAt', 'updatedAt']) &&
                         incoming().keys().hasOnly(['userId', 'title', 'body', 'category', 'createdAt', 'updatedAt']) &&
                         incoming().createdAt is timestamp && incoming().createdAt <= request.time &&
                         incoming().updatedAt is timestamp && incoming().updatedAt <= request.time &&
                         isValidSavedPrompt(incoming());

        allow update: if isOwner(userId) &&
                         isValidId(promptId) &&
                         isValidSavedPrompt(incoming()) &&
                         incoming().userId == existing().userId &&
                         incoming().createdAt == existing().createdAt &&
                         incoming().updatedAt is timestamp && incoming().updatedAt <= request.time &&
                         incoming().diff(existing()).affectedKeys().hasOnly(['title', 'body', 'category', 'updatedAt']);

        allow delete: if isOwner(userId) && isValidId(promptId);
      }
    }
  }
}
